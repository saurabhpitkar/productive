# Run setup.sh (Mac/Linux) or setup.ps1 (Windows) to fill this in interactively.
# Secrets (JWT_SECRET_KEY, FERNET_KEY) are generated automatically by the script.
# Manual instructions: see README.md

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create at console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.com/api/v1/auth/callback

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
# Create at github.com → Settings → Developer settings → OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Security ──────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=

# Generate: openssl rand -base64 32 | tr '+/' '-_' | tr -d '\n'
FERNET_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
APP_ORIGIN_V4=https://your-domain.com

# Comma-separated allowed emails; leave empty to allow any Google/GitHub account
ALLOWED_EMAILS=

# ── Storage ───────────────────────────────────────────────────────────────────
# Point to a local folder to store docs on your host filesystem instead of a Docker volume.
# When set, the folder is bind-mounted into the container at /data/docs.
# Leave empty (default) to keep docs inside the Docker-managed volume.
#
# Windows:   HOST_DOCS_DIR=C:/Users/YourName/Documents/my-notes
# Mac/Linux: HOST_DOCS_DIR=/Users/YourName/Documents/my-notes
HOST_DOCS_DIR=

# ── Inbox routing ─────────────────────────────────────────────────────────────
# Confidence threshold for auto-routing inbox notes (0.0–1.0, default 0.80)
ROUTE_THRESHOLD=0.80

# ── MCP server ────────────────────────────────────────────────────────────────
# Generate a PAT from Settings → API Access, toggle it Trusted, then paste here
MCP_PAT=
MCP_TRANSPORT=sse
MCP_PORT=3006

# ── Frontend ──────────────────────────────────────────────────────────────────
# Sync interval in ms: 180000 = 3 min, 1800000 = 30 min
VITE_SYNC_INTERVAL_MS=180000

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# Create at Zero Trust → Networks → Tunnels → Create tunnel → "productive-v4"
# Public hostname: your-domain.com → http://frontend-v4:3005
CLOUDFLARE_TUNNEL_TOKEN_V4=

# ── Rust logging ──────────────────────────────────────────────────────────────
RUST_LOG=info
