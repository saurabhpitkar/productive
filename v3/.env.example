# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create at console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://notes-v3.saurabhpitkar.com/api/v1/auth/callback

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
# Create at github.com → Settings → Developer settings → OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Security ──────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=

# Generate (Python): from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())
FERNET_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
APP_ORIGIN_V3=https://notes-v3.saurabhpitkar.com

# Comma-separated allowed emails; leave empty to allow any Google/GitHub account
ALLOWED_EMAILS=

# ── MCP server ────────────────────────────────────────────────────────────────
# Generate a PAT from Settings → API Access, then paste it here
MCP_PAT=
MCP_TRANSPORT=sse
MCP_PORT=3004

# ── Frontend ──────────────────────────────────────────────────────────────────
# Sync interval in ms: 180000 = 3 min, 1800000 = 30 min
VITE_SYNC_INTERVAL_MS=180000

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# Create at Zero Trust → Networks → Tunnels → Create tunnel → "productive-v3"
# Public hostname: notes-v3.saurabhpitkar.com → http://frontend-v3:3003
CLOUDFLARE_TUNNEL_TOKEN_V3=

# ── Rust logging ──────────────────────────────────────────────────────────────
RUST_LOG=info
