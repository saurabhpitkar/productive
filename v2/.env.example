# Copy this file to .env and fill in real values before running docker compose

# Google OAuth 2.0 credentials (from console.cloud.google.com)
# Steps:
#   1. Create project → APIs & Services → Credentials → Create OAuth 2.0 Client ID
#   2. Application type: Web application
#   3. Authorised redirect URIs:
#        http://localhost:3001/api/v1/auth/callback   (local)
#        https://your-v2-domain.com/api/v1/auth/callback  (production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/callback

# GitHub OAuth (optional alternative sign-in)
# Register at github.com/settings/developers → New OAuth App
# Callback URL: http://localhost:3001/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# JWT signing secret — generate: openssl rand -hex 32
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# Fernet key for encrypting API keys at rest — generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# V2 frontend public URL (used for CORS and OAuth redirect)
APP_ORIGIN_V2=http://localhost:3001

# Optional: comma-separated emails allowed to log in (leave empty = allow all)
ALLOWED_EMAILS=

# Frontend sync interval in milliseconds (default 3 minutes)
VITE_SYNC_INTERVAL_MS=180000

# Cloudflare tunnel token
CLOUDFLARE_TUNNEL_TOKEN=

# ── MCP Server ────────────────────────────────────────────────────────────────
# Generate a PAT in Settings → API Access, mark it as Trusted, paste it here.
# The MCP server uses this PAT to authenticate all tool calls on your behalf.
MCP_PAT=

# Transport mode: "sse" (default — for Claude.ai web via Cloudflare Tunnel)
#                 "stdio" — for Claude Desktop via docker exec -i
MCP_TRANSPORT=sse

# Port for SSE transport (must be exposed via Cloudflare Tunnel for remote access)
MCP_PORT=3002
